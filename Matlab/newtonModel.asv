clear;
clc; 

%% ============================================================
% 1. Symbolic variables
% =============================================================
syms q1 q2 q3 real
syms qdot1 qdot2 qdot3 real
syms qddot1 qddot2 qddot3 real
syms m1 m2 m3 real
syms g real

syms l1 l2 l3
syms lc1 lc2 lc3

l = [l1 l2 l3];
lc = [lc1 lc2 lc3];

q = [q1 q2 q3];
qdot = [qdot1 qdot2 qdot3];
qddot = [qddot1 qddot2 qddot3];

joint_count = length(q);
%% ============================================================
% 2. Link inertia matrices
% =============================================================
syms Ixx1 Iyy1 Izz1 Ixy1 Ixz1 Iyz1
I1 = [ Ixx1, Ixy1, Ixz1;
      Ixy1,  Iyy1, Iyz1;
      Ixz1, Iyz1,  Izz1];

syms Ixx2 Iyy2 Izz2 Ixy2 Ixz2 Iyz2
I2 = [ Ixx2, Ixy2, Ixz2;
      Ixy2,  Iyy2, Iyz2;
      Ixz2, Iyz2,  Izz2];

syms Ixx3 Iyy3 Izz3 Ixy3 Ixz3 Iyz3
I3 = [ Ixx3, Ixy3, Ixz3;
      Ixy3,  Iyy3, Iyz3;
      Ixz3, Iyz3,  Izz3];

%% ============================================================
% 3. Rotation matrices
% =============================================================

Rz = [  
    cos(q1), -sin(q1), 0;
    sin(q1), cos(q1), 0;
    0, 0, 1
     ];

Ry = [
    cos(q2), 0, sin(q2);
    0, 1, 0;
    -sin(q2), 0, cos(q2)
    ];

Rx = [
    cos(q3), -sin(q3), 0;
    sin(q3), cos(q3), 0;
    0, 0, 1
    ];

R01 = Rz;
R12 = -Ry;
R23 = -Ry;

R02 = R01 * R12;
R03 = R02 * R23;

R0_i = {R01 R02 R03};
Ri = {R01 R12 R23};

%% ============================================================
% 4. Joint axes expressed in world frame
% =============================================================

x_axis = [1; 0; 0];
y_axis = [0; 1; 0];
z_axis = [0; 0; 1];

origins = {z_axis, -y_axis, -y_axis};

a1 = R01 * origins{1};
a2 = R02 * origins{2};
a3 = R03 * origins{3};

axies = {a1, a2, a3};

%% ============================================================
% 5. Angular and Acceleration
% =============================================================

w = repmat({zeros(3,1)},3,1);
alpha = repmat({zeros(3,1)},3,1);
n = length(w);

wi_1 = [0; 0; 0];
ai_1 = [0; 0; 0];

for i =1:n
    bi = transpose(R01) * axies{i};
    Ri_T = transpose(Ri{1});
    b_qdot = bi * qdot(i);
    w{i} = Ri_T * wi_1 + b_qdot;
    alpha{i} = Ri_T * ai_1 + bi * qddot(i) + cross(w{i}, b_qdot);

    % Set new w(i-1) and a(i-1)
    wi_1 = w{i};
    ai_1 = alpha{i};
end

%% ============================================================
% 6. Center of mass
% =============================================================
% rc = repmat({zeros(3,1)}, 3, joint_count);
% 
% r1c1 = lc1 * origins{1};
% r2c1 = (lc1 - l1) * origins{1};
% r12 = l1 * origins{1};
% 
% rc{1, 1} = r1c1;
% rc{2, 1} = r2c1;
% rc{3, 1} = r12;
% 
% r2c2 = lc2 * origins{2};
% r3c2 = (lc1 - l1) * origins{2};
% r23 = l1 * origins{2};
% 
% rc{1, 2} = r2c2;
% rc{2, 2} = r3c2;
% rc{3, 2} = r23;
ac = repmat({zeros(3,1)}, 1, joint_count);
ae = repmat({zeros(3,1)}, 1, joint_count);

aei_1 = 0;

for i = 1:joint_count
    rici = lc(i) * origins{i};
    riici = (lc(i) - l(1) * origins{i};
    rii = l1 * origins{i};
    R0_i_T = transpose(R0_i(i));

    aci = R0_i_T * aei_1 + cross(alpha{i}, rici) + cross(w{1}, cross(w{1}, rici));
    
end